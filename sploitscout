def _suffix_rank(s):
    s = s.lower().strip(".-_ ")
    if not s:
        return (0, 0)
    m = re.match(r"(dev|alpha|pre|beta|rc)(\d*)", s)
    if m:  # pre-releases sort before the release
        return (-1, ("dev", "alpha", "pre", "beta", "rc").index(m.group(1)) * 1000 + int(m.group(2) or 0))
    if re.fullmatch(r"p\d+", s):  # OpenSSH style 7.4p1 is treated as 7.4
        return (0, 0)
    m = re.fullmatch(r"([a-z])(\d*)", s)  # OpenSSL style 1.0.1f is after 1.0.1
    if m:
        return (1, ord(m.group(1)) * 1000 + int(m.group(2) or 0))
    return (0, 0)


class V:
    """A comparable version: '5.12.5', '7.4p1', '3.0.25rc3', '5.12.x' ..."""
    __slots__ = ("raw", "nums", "wild", "suf")

    def __init__(self, raw):
        self.raw = raw.strip().lstrip("vV")
        m = re.match(r"(\d+(?:\.(?:\d+|[xX*]))*)(.*)", self.raw)
        self.nums, self.wild = [], False
        for part in m.group(1).split("."):
            if part in ("x", "X", "*"):
                self.wild = True
                break
            self.nums.append(int(part))
        self.suf = _suffix_rank(m.group(2))

    def key(self, hi=False):
        fill = 10 ** 9 if hi else 0
        nums = (self.nums + [fill] * 6)[:6]
        suf = self.suf if (self.suf != (0, 0) or not hi) else (10 ** 9, 0)
        return tuple(nums) + suf

    def __str__(self):
        return self.raw


POST_UP = {"earlier", "below", "prior", "older", "lower", "before", "previous", "less"}
POST_LO = {"later", "above", "newer", "higher", "greater"}
PREFIX_UP = {"before", "prior", "below", "until", "till", "under", "pre", "lt"}
FILLER = {"version", "versions", "ver", "v", "release", "releases", "series", "branch", "http", "server",
          "httpd", "web", "daemon", "ftp", "ftpd", "ssh", "sshd", "smbd", "smtp", "smtpd", "imap", "pop3",
          "db", "database", "mail", "portable", "is", "are", "in", "of", "all", "the", "from", "including",
          "inclusive", "affected", "affects", "affecting", "vulnerable", "on", "edition", "community",
          "enterprise", "=", ":", "and", "including", "with", "running", "software"}


def _mk_range(lo, hi, incl, shorthand=False):
    """'1.3.29-36' means 1.3.29 – 1.3.36. Returns None if the range makes no sense."""
    if not hi.wild and len(hi.nums) < len(lo.nums) and (shorthand or hi.key() < lo.key()):
        hi = V(".".join(map(str, lo.nums[: len(lo.nums) - len(hi.nums)] + hi.nums)))
    if hi.key(hi=incl) < lo.key():
        return None
    return ("rng", lo, hi, incl)


def parse_versions(window):
    """Turn 'vsftpd 2.3.0 < 2.3.5 / 3.x and earlier' style text into version specs."""
    toks = TOKEN_RE.findall(window)
    specs, op, lo_idx, seen, junk = [], None, None, False, 0
    i = 0
    while i < len(toks):
        t, low = toks[i], toks[i].lower()
        nxt = toks[i + 1].lower() if i + 1 < len(toks) else ""
        nxt2_is_ver = i + 2 < len(toks) and VER_RE.fullmatch(toks[i + 2]) is not None
        if VER_RE.fullmatch(t):
            v = V(t)
            if op in ("<", "<="):
                if lo_idx is not None:
                    specs[lo_idx] = _mk_range(specs[lo_idx][1], v, op == "<=") or specs[lo_idx]
                else:
                    specs.append(("up", v, op == "<="))
            elif op in ("thru", "dash"):
                if lo_idx is not None:
                    specs[lo_idx] = _mk_range(specs[lo_idx][1], v, True, op == "dash") or specs[lo_idx]
                else:
                    specs.append(("up", v, True))
            elif op == ">=":
                specs.append(("lo", v))
            else:
                specs.append(("pt", v))
            lo_idx = len(specs) - 1 if op is None else None
            op, seen = None, True
            i += 1
            continue
        if low in ("<", "<=", "=<"):
            op = "<=" if "=" in low else "<"
        elif low in (">", ">=", "=>"):
            op, lo_idx = ">=", None
        elif low in ("-", "~"):
            op = "dash"
        elif low in ("through", "thru") or (low == "to" and lo_idx is not None):
            op = "thru"
        elif low in ("and", "or", ",", "/", "&"):
            last_pt = specs and specs[-1][0] == "pt"
            if last_pt and nxt in POST_UP and not nxt2_is_ver:
                specs[-1] = ("up", specs[-1][1], True)
                i += 2
                lo_idx = None
                continue
            if last_pt and nxt in POST_LO:
                specs[-1] = ("lo", specs[-1][1])
                i += 2
                lo_idx = None
                continue
            op, lo_idx = None, None
        elif low == "+" and specs and specs[-1][0] == "pt":
            specs[-1] = ("lo", specs[-1][1])
        elif low == "up" and nxt == "to":
            op, lo_idx = "<=", None
            i += 2
            continue
        elif low in PREFIX_UP and (nxt == "to" or VER_RE.fullmatch(nxt or "-") or nxt in FILLER):
            op, lo_idx = "<", None
            if nxt == "to":
                i += 1
        elif low in POST_UP and specs and specs[-1][0] == "pt":
            specs[-1] = ("up", specs[-1][1], True)
        elif low in POST_LO and specs and specs[-1][0] == "pt":
            specs[-1] = ("lo", specs[-1][1])
        elif low in FILLER:
            pass
        else:  # an unrelated word or bracket
            if seen or re.match(r"[A-Za-z_]", t):
                break  # e.g. "Apache + PHP < 5.3": that version belongs to PHP, not Apache
            junk += 1
            if junk > 3:
                break
        i += 1
    return specs


def match_spec(T, s):
    kind = s[0]
    if kind == "pt":
        P = s[1]
        n = len(P.nums)
        if P.wild:
            if n and T.nums[:n] == P.nums:
                return ("family", f"{P.raw} family") if n >= 2 else ("major", f"same major ({P.raw})")
            return None
        if P.key() == T.key():
            return ("exact", f"exact {P.raw}")
        if n < len(T.nums) and T.nums[:n] == P.nums:
            return ("family", f"{P.raw} family") if n >= 2 else ("major", f"same major ({P.raw})")
        if n >= 3 and len(T.nums) >= 2 and T.nums[:2] == P.nums[:2]:
            return ("near", f"close version {P.raw}")
        return None
    kT = T.key()
    if kind == "rng":
        lo, hi, incl = s[1], s[2], s[3]
        khi = hi.key(hi=incl)
        if lo.key() <= kT and (kT <= khi if incl else kT < khi):
            return ("range", f"in range {lo.raw} – {hi.raw}")
        return None
    if kind == "up":
        hi, incl = s[1], s[2]
        khi = hi.key(hi=incl)
        if kT <= khi if incl else kT < khi:
            return ("range", f"in range {'≤' if incl else '<'} {hi.raw}")
        return None
    if kind == "lo":  # open-ended "2.3 and later": weak evidence
        if kT >= s[1].key():
            return ("major", f"≥ {s[1].raw} (open-ended)")
        return None
    return None


def rate_version(T, specs):
    """Best match tier between your version T and an exploit's version specs."""
    if T is None:
        return "unknown", "your version is unknown"
    if not specs:
        return "product", "product only, no version listed"
    best = None
    for s in specs:
        r = match_spec(T, s)
        if r and (best is None or TIER_W[r[0]] > TIER_W[best[0]]):
            best = r
    return best or (None, None)


def kw_regex(kw):
    # "php" must not match "unixlogin.php" or "phpBB"
    return re.compile(r"(?<![\w./-])" + r"\s+".join(map(re.escape, kw.split())) + r"(?![\w-]|\.\w)", re.I)


def find_specs(text, kw_res, title=False):
    """Find the product name in text and parse the versions written right after it."""
    text = " ".join(text.split())
    hit, specs = False, []
    for rx in kw_res:
        for m in rx.finditer(text):
            hit = True
            tail = text[m.end(): m.end() + 140]
            if title:
                tail = tail.split(" - ")[0]
            else:
                tail = re.split(r"(?<=[\w)])\.(?:\s|$)|;|:\s", tail)[0]
            specs += parse_versions(tail)
    return hit, specs


