class ExploitDB:
    name = "searchsploit"

    def __init__(self):
        self.dir, self.rows, self.ok, self.error = None, [], False, None

    def load(self):
        cands = []
        exe = shutil.which("searchsploit")
        if exe:
            cands.append(os.path.dirname(os.path.realpath(exe)))
        for rc in ("~/.searchsploit_rc", "/etc/searchsploit_rc", "/usr/share/exploitdb/.searchsploit_rc"):
            try:
                with open(os.path.expanduser(rc)) as fh:
                    cands += re.findall(r'path_array\+=\("([^"]+)"\)', fh.read())
            except OSError:
                pass
        cands += ["/usr/share/exploitdb", "/usr/share/exploit-database", "/opt/exploitdb",
                  "/opt/exploit-database", os.path.expanduser("~/exploitdb")]
        for d in cands:
            f = os.path.join(d, "files_exploits.csv")
            if os.path.isfile(f):
                with open(f, newline="", encoding="utf-8", errors="replace") as fh:
                    self.rows = [r for r in csv.DictReader(fh) if r.get("description")]
                self.dir, self.ok = d, True
                return True
        self.error = "not found  (install: yay -S exploitdb)"
        return False

    def search(self, sw, T):
        kws = [kw_regex(k) for k in sw.keywords]
        lows = [k.lower() for k in sw.keywords]
        ex = [kw_regex(e) for e in sw.exclude]
        out = []
        for r in self.rows:
            title = r["description"]
            tl = title.lower()
            if not any(k in tl for k in lows) or not any(rx.search(title) for rx in kws):
                continue
            if any(e.search(title) for e in ex):
                continue
            _, specs = find_specs(title, kws, title=True)
            tier, reason = rate_version(T, specs)
            if tier is None:
                continue
            etype = (r.get("type") or "").lower()
            impact, ipts = classify_impact(title, etype)
            verified = (r.get("verified") or "") == "1"
            rel_label, rel = ("verified", 40) if verified else ("unverified", 30)
            if "(metasploit)" in tl:
                rel_label, rel = rel_label + "+msf", min(50, rel + 5)
            cves = sorted(set(c.upper() for c in CVE_RE.findall(r.get("codes") or "")))
            eid = r["id"]
            path = os.path.join(self.dir, r["file"])
            out.append(Finding("searchsploit", title, f"EDB-{eid}", tier, reason, impact, ipts, rel_label, rel,
                               cves, set(cves) | {f"EDB-{eid}"},
                               {"edb_id": eid, "path": path, "type": etype, "platform": r.get("platform"),
                                "os_family": os_family(r.get("platform")),
                                "url": f"https://www.exploit-db.com/exploits/{eid}"}))
        return out


class Metasploit:
    name = "metasploit"

    def __init__(self):
        self.mods, self.ok, self.error, self.path = [], False, None, None

    def load(self):
        cands = [os.path.expanduser("~/.msf4/store/modules_metadata.json"),
                 "/opt/metasploit/db/modules_metadata_base.json",
                 "/usr/share/metasploit-framework/db/modules_metadata_base.json",
                 "/opt/metasploit-framework/embedded/framework/db/modules_metadata_base.json"]
        exe = shutil.which("msfconsole")
        if exe:
            cands.append(os.path.join(os.path.dirname(os.path.realpath(exe)), "db", "modules_metadata_base.json"))
        found = [c for c in cands if os.path.isfile(c)]
        if not found:
            self.error = "not found  (install: sudo pacman -S metasploit)"
            return False
        self.path = max(found, key=os.path.getmtime)
        try:
            with open(self.path, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError) as e:
            self.error = f"could not read module index ({e})"
            return False
        self.mods = [m for m in data.values() if m.get("type") in ("exploit", "auxiliary")]
        self.ok = True
        return True

    def search(self, sw, T):
        kws = [kw_regex(k) for k in sw.keywords]
        lows = [k.lower() for k in sw.keywords]
        ex = [kw_regex(e) for e in sw.exclude]
        out = []
        for m in self.mods:
            name = m.get("name") or ""
            desc = " ".join((m.get("description") or "").split())
            desc_only = False
            if any(k in name.lower() for k in lows) and any(rx.search(name) for rx in kws):
                if any(e.search(name) for e in ex):
                    continue
                _, specs = find_specs(name, kws)
                if not specs:
                    _, specs = find_specs(desc, kws)
            else:
                if not any(k in desc.lower() for k in lows) or not any(rx.search(desc) for rx in kws):
                    continue
                if any(e.search(name) or e.search(desc) for e in ex):
                    continue
                _, specs = find_specs(desc, kws)
                if not specs:  # only mentioned in passing
                    continue
                desc_only = True
            tier, reason = rate_version(T, specs)
            if tier is None:
                continue
            if desc_only:  # product is only named in the description: probably a 3rd-party app on top of it
                tier = DOWNGRADE.get(tier, tier)
                reason += " (desc only)"
            full = m.get("fullname", "")
            kind = "dos" if full.startswith("auxiliary/dos/") else ""
            impact, ipts = classify_impact(name + " " + desc[:300], kind)
            if m.get("type") == "exploit":
                rel_label, rel = MSF_RANK.get(m.get("rank", 300), ("normal", 34))
            else:
                rel_label, rel = "auxiliary", 30
            refs = m.get("references") or []
            cves = sorted(set(r.upper() for r in refs if r.upper().startswith("CVE-")))
            edbs = {r.upper() for r in refs if r.upper().startswith("EDB-")}
            out.append(Finding("metasploit", name, full, tier, reason, impact, ipts, rel_label, rel,
                               cves, set(cves) | edbs,
                               {"module": full, "type": m.get("type"), "check": bool(m.get("check")),
                                "rank": rel_label, "default_rport": m.get("rport"),
                                "os_family": os_family(full.split("/")[1] if full.count("/") > 1 else "")
                                             or (None if "," in (m.get("platform") or "")
                                                 else os_family(m.get("platform"))),
                                "url": f"https://www.rapid7.com/db/modules/{full}/"}))
        return out


class GitHub:
    """Public PoC repos on GitHub, via the official search API (uses your `gh` login when available)."""
    name = "github"

    def __init__(self):
        self.ok, self.error, self.cache, self.mode, self.last = True, None, {}, "anon", 0.0

    def load(self):
        if shutil.which("gh") and subprocess.run(["gh", "auth", "status"], capture_output=True).returncode == 0:
            self.mode = "gh"  # 30 searches/min
        return True

    @property
    def delay(self):
        return 2.1 if self.mode == "gh" else 6.5  # stay under GitHub's search rate limit

    def _search(self, q):
        if q in self.cache:
            return self.cache[q]
        wait = self.delay - (time.time() - self.last)
        if wait > 0:
            time.sleep(wait)
        self.last = time.time()
        params = {"q": q, "sort": "stars", "order": "desc", "per_page": "10"}
        try:
            if self.mode == "gh":
                cmd = ["gh", "api", "-X", "GET", "search/repositories"]
                for k, v in params.items():
                    cmd += ["-f", f"{k}={v}"]
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                if r.returncode != 0:
                    raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1][:100])
                data = json.loads(r.stdout)
            else:
                req = urllib.request.Request(
                    "https://api.github.com/search/repositories?" + urllib.parse.urlencode(params),
                    headers={"Accept": "application/vnd.github+json", "User-Agent": "sploitscout"})
                with urllib.request.urlopen(req, timeout=15) as resp:
                    data = json.load(resp)
        except Exception as e:
            self.error = str(e)[:100]
            if "rate limit" in self.error.lower() or "403" in self.error:
                self.ok = False
            data = {}
        items = data.get("items", []) if isinstance(data, dict) else []
        self.cache[q] = items
        return items

    @staticmethod
    def _reliability(stars):
        pts = 32 if stars >= 100 else 28 if stars >= 25 else 24 if stars >= 5 else 18
        return f"stars:{stars}", pts

    def search(self, sw, T, cve_info):
        """cve_info: {CVE: (tier, impact, impact_pts)} from the searchsploit/metasploit hits."""
        if not self.ok:
            return []
        kws = [kw_regex(k) for k in sw.keywords]
        ex = [kw_regex(e) for e in sw.exclude]
        out, seen = [], set()

        def add(item, tier, reason, impact=None):
            name = item.get("full_name", "")
            if not name or name in seen or item.get("fork"):
                return
            seen.add(name)
            desc = (item.get("description") or "").strip()
            imp, ipts = classify_impact(f"{name.replace('-', ' ')} {desc}")
            if impact and (imp == "Other" or impact[1] > ipts):
                imp, ipts = impact
            rel_label, rel = self._reliability(item.get("stargazers_count", 0))
            text = f"{name} {desc}"
            cves = sorted(set(c.upper() for c in CVE_RE.findall(text)))
            out.append(Finding("github", f"{name}" + (f": {desc[:90]}" if desc else ""), item.get("html_url", ""),
                               tier, reason, imp, ipts, rel_label, rel, cves, set(cves),
                               {"url": item.get("html_url", ""), "repo": name,
                                "updated": (item.get("pushed_at") or "")[:10]}))

        # 1) PoCs for the CVEs searchsploit/metasploit already matched to this version
        for cve, (tier, impact, ipts) in list(cve_info.items())[:2]:
            for item in self._search(cve)[:4]:
                if cve.lower() in f"{item.get('full_name', '')} {item.get('description') or ''}".lower():
                    add(item, tier, f"{tier} via {cve}", (impact, ipts))
        # 2) "<product> <version> exploit"
        q = f"{sw.keywords[0]} {sw.version} exploit".replace("  ", " ") if sw.version else f"{sw.keywords[0]} exploit"
        for item in self._search(q)[:8]:
            name = item.get("full_name", "").split("/")[-1]
            text = f"{re.sub(r'[-_]', ' ', name)} {item.get('description') or ''}"
            if not any(rx.search(text) for rx in kws) or any(e.search(text) for e in ex):
                continue
            _, specs = find_specs(text, kws)
            tier, reason = rate_version(T, specs)
            if tier:
                add(item, tier, reason)
        return out[:3]


def google_url(q):
    return "https://www.google.com/search?q=" + urllib.parse.quote_plus(q)


def google_queries(sw):
    if not sw.version:
        return [f"{sw.product} exploit"]
    return [f"{sw.product} {sw.version} exploit"]


def open_in_browser(urls):
    """Open Google searches as tabs for *you* to read (no scraping)."""
    if os.geteuid() == 0:
        return "not opening a browser as root, use the links above"
    for exe in ("chromium", "google-chrome-stable", "google-chrome", "brave", "firefox"):
        path = shutil.which(exe)
        if path:
            subprocess.Popen([path, "--new-window", *urls], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return f"opened {len(urls)} Google searches in {exe}"
    if shutil.which("xdg-open"):
        for u in urls:
            subprocess.Popen(["xdg-open", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        return f"opened {len(urls)} Google searches"
    return "no browser found, use the links above"


