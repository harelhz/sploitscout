def write_markdown(path, meta, results, args):
    L = [f"# sploitscout report: {os.path.basename(meta['target'])}", "",
         f"- **Date:** {meta['date']}",
         f"- **Scan:** `{meta['cmd']}`" if meta["cmd"] else f"- **Source:** {meta['target']}", ""]
    for host, port_rows in results:
        L += [f"## Host {host.addr}" + (f" ({host.hostname})" if host.hostname else ""), ""]
        if host.os:
            L += [f"OS guess: {host.os}", ""]
        L += ["| Port | Service | Product / version |", "|---|---|---|"]
        for p in host.ports:
            L.append(f"| {p.port}/{p.proto} | {p.service} | {p.product} {p.version} |")
        L.append("")
        for port, sw, fs in port_rows:
            shown = fs if args.all else [f for f in fs if f.score >= args.min_score][: args.top]
            L += [f"### {port.port}/{port.proto} · {sw.label}", ""]
            if not shown:
                L += ["_No public exploits matched._", ""]
                continue
            L += ["| Score | Exploit | Found in | Version match | Type | Ref |", "|---|---|---|---|---|---|"]
            for f in shown:
                name = f.name.replace("|", "\\|")
                L.append(f"| **{f.score}** | {name} | {f.source} | {f.reason} | {f.impact} | `{f.ref}` |")
            L.append("")
            native = {c: f.extra["module"] for f in fs
                      if f.source == "metasploit" and f.extra.get("type") == "exploit" for c in f.cves}
            for i, f in enumerate(shown[: args.howto], 1):
                L += [f"**#{i} {f.name}** ({f.source})", "", "```bash"]
                L += [f"{c}    # {n}" for c, n in howto(f, host.addr, port.port, meta["lhost"], native)]
                L += ["```", ""]
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(L))


def write_json(path, meta, results):
    data = {"meta": meta, "hosts": []}
    for host, port_rows in results:
        data["hosts"].append({
            "addr": host.addr, "hostname": host.hostname, "os": host.os,
            "ports": [{"port": p.port, "proto": p.proto, "service": p.service, "product": p.product,
                       "version": p.version} for p in host.ports],
            "findings": [{"port": port.port, "software": sw.label, "results": [f.as_dict() for f in fs]}
                         for port, sw, fs in port_rows]})
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)


def write_html(path, items, title, svg=False):
    rec = Console(record=True, width=130 if svg else 150, file=io.StringIO(), force_terminal=True,
                  color_system="truecolor")
    for it, soft in items:
        rec.print(it, soft_wrap=soft and not svg)
    if svg:
        rec.save_svg(path, title=title, theme=MONOKAI)
        return
    rec.save_html(path, theme=MONOKAI)
    with open(path, encoding="utf-8") as fh:
        page = fh.read()
    page = page.replace("<head>", f"<head>\n<title>{html.escape(title)}</title>", 1)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(page)


