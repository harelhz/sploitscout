def short_ref(f):
    if f.source == "searchsploit":
        bits = [f.ref, *f.cves[:2], f.rel_label]
    elif f.source == "metasploit":
        bits = [f.ref, f.rel_label] + (["check ✔"] if f.extra.get("check") else []) + f.cves[:2]
    else:
        bits = [f"github.com/{f.extra.get('repo', '')}", f.rel_label,
                f"updated {f.extra['updated']}" if f.extra.get("updated") else "", *f.cves[:2]]
    return " · ".join(b for b in bits if b)


def howto(f, ip, port, lhost, native=None):
    """Copy-paste commands to look at / load an exploit. Never runs anything itself.
    native: {CVE: metasploit module} found for the same service, used for old EDB msf modules."""
    cmds = []
    native = native or {}
    if not port:  # manual lookup: no real port, use the module's default if it has one
        port = f.extra.get("default_rport") or "<port>"
    if f.source == "searchsploit":
        eid = f.extra["edb_id"]
        ext = os.path.splitext(f.extra["path"])[1].lower()
        fn = f"{eid}{ext}"
        cmds.append((f"searchsploit -x {eid}", "read it first"))
        cmds.append((f"searchsploit -m {eid}", f"copy it here as {fn}"))
        runner = {".py": f"python3 {fn} -h", ".sh": f"bash {fn}", ".pl": f"perl {fn}", ".php": f"php {fn}",
                  ".js": f"node {fn}", ".go": f"go run {fn}", ".ps1": f"pwsh {fn}",
                  ".c": f"gcc {fn} -o x{eid} && ./x{eid}", ".cpp": f"g++ {fn} -o x{eid} && ./x{eid}",
                  ".java": f"javac {fn}", ".rb": f"ruby {fn}"}.get(ext)
        if ext == ".rb" and "metasploit" in f.name.lower():
            mod = next((native[c] for c in f.cves if c in native), None)
            if mod:  # old EDB copies of msf modules often don't load in msf6: use the built-in one
                cmds = [(f'msfconsole -q -x "use {mod}; set RHOSTS {ip}; set RPORT {port}; show options"',
                         "same exploit is built into Metasploit: use that one")]
            else:
                cmds.append((f"mkdir -p ~/.msf4/modules/exploits/edb && cp {fn} ~/.msf4/modules/exploits/edb/",
                             "it's an msf module: install it"))
                cmds.append((f'msfconsole -q -x "use exploit/edb/{eid}; set RHOSTS {ip}; set RPORT {port}; '
                             f'show options"', "load it with your target"))
        elif runner:
            cmds.append((runner, f"check its usage, then point it at {ip}:{port}"))
        else:
            cmds.append((f"less {fn}", "manual steps: follow the write-up"))
    elif f.source == "metasploit":
        mod = f.extra["module"]
        opts = f"use {mod}; set RHOSTS {ip}; set RPORT {port}"
        if f.extra.get("type") == "exploit":
            opts += f"; set LHOST {lhost}"
        opts += "; check" if f.extra.get("check") else "; show options"
        cmds.append((f'msfconsole -q -x "{opts}"',
                     "loads it with your target set" + (" and runs 'check'" if f.extra.get("check") else "")))
        cmds.append(("run", "type this inside msfconsole when you're ready"))
    else:
        url = f.ref
        m = re.match(r"https?://github\.com/([^/]+)/([^/#?]+)", url)
        if m:
            repo = m.group(2).removesuffix(".git")
            cmds.append((f"git clone https://github.com/{m.group(1)}/{repo}", "grab the PoC"))
            cmds.append((f"less {repo}/README.md", f"read the usage, target is {ip}:{port}"))
            cmds.append((f"grep -rnE 'curl|wget|base64|eval|exec' {repo} | head",
                         "⚠ read the code before running it: fake PoCs with malware exist"))
        else:
            cmds.append((f"xdg-open '{url}'", "read the write-up in your browser"))
    return cmds


def findings_block(host, port, sw, fs, args, lhost):
    """Everything printed for one service. Returns [(renderable, soft_wrap)].
    Commands are printed with soft_wrap so a long command copies as one clean line."""
    ip = host.addr
    shown = fs if args.all else [f for f in fs if f.score >= args.min_score][: args.top]
    hidden = len(fs) - len(shown)
    if port.port:
        title = Text.assemble((f" {port.port}/{port.proto} ", "bold black on cyan"), " ",
                              (port.service or "?", "cyan"), ("  ·  ", "grey50"))
    else:
        title = Text.assemble((" lookup ", "bold black on cyan"), "  ")
    title.append_text(Text.assemble((sw.product, "bold white"),
                                    (f" {sw.raw_version}" if sw.raw_version else " (version unknown)",
                                     "bold green" if sw.version else "grey50")))
    if sw.origin not in ("nmap", "manual"):
        title.append(f"  [{sw.origin}]", style="grey50")
    title.append(" ")
    parts = [(Text(""), False), (Rule(title, align="left", style="cyan", characters="━"), False)]
    if not shown:
        msg = Text("  No public exploits matched this version", style="grey62")
        if fs:
            msg.append(f" above score {args.min_score} ({len(fs)} weaker hits, use --all)", style="grey50")
        msg.append(".\n  That's not proof it's safe: check default creds, misconfigs and the web app itself.",
                   style="grey50")
        parts.append((msg, False))
        return parts
    t = Table(box=box.SIMPLE_HEAD, header_style="bold magenta", expand=True, padding=(0, 1),
              border_style="grey42")
    t.add_column("#", style="grey62", width=2, justify="right")
    t.add_column("SCORE", width=5, no_wrap=True)
    t.add_column("EXPLOIT", ratio=6, overflow="fold")
    t.add_column("FOUND IN", width=12, no_wrap=True)
    t.add_column("VERSION MATCH", ratio=2, overflow="fold")
    t.add_column("TYPE", no_wrap=True)
    for i, f in enumerate(shown, 1):
        name = Text(f.name, style="bold white")
        name.append("\n" + short_ref(f), style="grey50")
        base = f.impact.removeprefix("Local ")
        t.add_row(str(i), sev_badge(f.score), name, Text(f.source, style=SRC_STYLE[f.source]),
                  Text(f.reason, style=TIER_STYLE[f.tier]), Text(f.impact, style=IMPACT_STYLE.get(base, "white")))
    parts.append((t, False))
    if hidden:
        parts.append((Text(f"  + {hidden} weaker results hidden (score < {args.min_score}"
                           f"{' or past --top ' + str(args.top) if len(fs) > args.top else ''}). "
                           f"Use --all to see them.", style="grey50 italic"), False))
    if args.howto > 0:
        native = {c: f.extra["module"] for f in fs if f.source == "metasploit" and f.extra.get("type") == "exploit"
                  for c in f.cves}
        parts.append((Text("\n  🛠  HOW TO USE", style="bold magenta"), False))
        for i, f in enumerate(shown[: args.howto], 1):
            parts.append((Text.assemble((f"  #{i} ", "bold magenta"), (f.name, "bold white"), ("  ", ""),
                                        (f"[{f.source}]", SRC_STYLE[f.source])), False))
            for cmd, note in howto(f, ip, port.port, lhost, native):
                parts.append((Text.assemble(("     $ ", "magenta"), (cmd, "bold green"),
                                            (f"   # {note}", "grey50 italic")), True))
    return parts


def summary_table(rows, args):
    t = Table(title="[bold]🎯 TOP FINDINGS[/]", title_justify="left", box=box.ROUNDED, border_style="magenta",
              header_style="bold magenta", expand=True)
    t.add_column("SCORE", width=6, no_wrap=True)
    t.add_column("TARGET", style="bold white", no_wrap=True)
    t.add_column("SERVICE", style="cyan", ratio=2, overflow="fold")
    t.add_column("EXPLOIT", ratio=5, overflow="fold")
    t.add_column("FOUND IN", width=12, no_wrap=True)
    for host, port, sw, f in rows:
        t.add_row(sev_badge(f.score), f"{host.addr}:{port.port}" if port.port else "lookup", sw.label,
                  Text(f.name, style="bold white") + Text(f"\n{f.ref}", style="grey50"),
                  Text(f.source, style=SRC_STYLE[f.source]))
    return t


def local_ip_for(target):
    try:
        dest = socket.gethostbyname(target.split("/")[0])
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((dest, 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "<your-ip>"


