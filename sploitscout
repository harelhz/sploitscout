PHASES = {"ping scan": "Host discovery", "arp ping scan": "Host discovery",
          "parallel dns resolution": "Resolving DNS", "syn stealth scan": "Port scan",
          "connect scan": "Port scan", "service scan": "Detecting service versions",
          "os detection": "OS fingerprinting", "nse": "Running nmap scripts", "traceroute": "Traceroute",
          "udp scan": "UDP scan"}
OPEN_RE = re.compile(r"Discovered open port (\d+)/(\w+) on (\S+)")
INIT_RE = re.compile(r"^Initiating (.+?)(?: against .+?)? at [\d:]+")
TIMING_RE = re.compile(r"^(.+?) Timing: About ([\d.]+)% done(?:; ETC: [\d:]+ \((.+?) remaining\))?")
DONE_RE = re.compile(r"^Completed (.+?)(?: against .+?)? at [\d:]+, ([\d.]+)s elapsed")


def friendly(phase, allports):
    name = PHASES.get(phase.strip().lower(), phase.strip())
    if name == "Port scan" and allports:
        name = "Port scan (all 65,535 ports)"
    return name


def sudo_prefix():
    if os.geteuid() == 0:
        return []
    if not shutil.which("sudo"):
        console.print("[red]✘ nmap -A needs root and sudo isn't installed. Run as root.[/]")
        sys.exit(1)
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode != 0:
        console.print("  [yellow]🔑 nmap -A needs root, sudo will ask for your password:[/]")
        if subprocess.run(["sudo", "-v"]).returncode != 0:
            console.print("[red]✘ sudo failed, can't scan.[/]")
            sys.exit(1)
    return ["sudo"]


def run_nmap(scan_args, targets, tmpdir, tag, allports, show_ports=True):
    """Run nmap with a live progress bar. Returns (xml_text, normal_text, tail_lines)."""
    xml_path, txt_path = os.path.join(tmpdir, f"{tag}.xml"), os.path.join(tmpdir, f"{tag}.txt")
    cmd = sudo_prefix() + ["nmap", *scan_args, "-v", "--stats-every", "3s", "-oX", xml_path, "-oN", txt_path,
                           *targets]
    tail = deque(maxlen=25)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last_done = None
    try:
        with Progress(SpinnerColumn("dots12", style="magenta"), TextColumn("[bold]{task.description}"),
                      BarColumn(bar_width=28, complete_style="magenta", finished_style="green"),
                      TaskProgressColumn(), TextColumn("[dim]{task.fields[eta]}"), TimeElapsedColumn(),
                      console=console, transient=True) as prog:
            task = prog.add_task("Starting nmap", total=100, eta="")
            for line in proc.stdout:
                line = line.rstrip()
                tail.append(line)
                if m := OPEN_RE.search(line):
                    if not show_ports:
                        continue
                    prog.console.print(f"     [bold green]➜[/] open port [bold white]{m[1]}/{m[2]}[/]"
                                       + (f" [dim]on {m[3]}[/]" if len(targets) > 1 or "/" in targets[0] else ""))
                elif m := TIMING_RE.match(line):
                    prog.update(task, description=friendly(m[1], allports), completed=float(m[2]),
                                eta=f"~{m[3]} left" if m[3] else "")
                elif m := INIT_RE.match(line):
                    prog.update(task, description=friendly(m[1], allports), completed=0, eta="")
                elif m := DONE_RE.match(line):
                    name = friendly(m[1], allports)
                    if float(m[2]) >= 0.5 and name != last_done:
                        prog.console.print(f"     [cyan]✔[/] {name} [dim]({float(m[2]):.1f}s)[/]")
                        last_done = name
            proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        raise
    xml_text = txt = ""
    try:
        with open(xml_path, encoding="utf-8", errors="replace") as fh:
            xml_text = fh.read()
        with open(txt_path, encoding="utf-8", errors="replace") as fh:
            txt = fh.read()
    except OSError:
        pass
    if proc.returncode != 0 or not xml_text.strip():
        console.print("[red]✘ nmap failed:[/]")
        for t in list(tail)[-10:]:
            console.print(Text("   " + t, style="dim"))  # Text(): nmap output may contain [brackets]
        sys.exit(1)
    return xml_text, txt, list(tail)


def parse_nmap_xml(text):
    root = ET.fromstring(text)
    hosts = []
    for h in root.findall("host"):
        st = h.find("status")
        if st is not None and st.get("state") != "up":
            continue
        addr_el = h.find("address[@addrtype='ipv4']")
        if addr_el is None:
            addr_el = h.find("address")
        addr = addr_el.get("addr") if addr_el is not None else "?"
        hn = h.find("hostnames/hostname")
        osm = h.find("os/osmatch")
        os_name = f"{osm.get('name')} ({osm.get('accuracy')}%)" if osm is not None else ""
        hostscripts = {s.get("id"): s.get("output", "") for s in h.findall("hostscript/script")}
        ports = []
        for p in h.findall("ports/port"):
            state = p.find("state")
            if state is None or state.get("state") != "open":
                continue
            svc = p.find("service")
            a = svc.attrib if svc is not None else {}
            scripts = {s.get("id"): s.get("output", "") for s in p.findall("script")}
            ports.append(Port(int(p.get("portid")), p.get("protocol", "tcp"), a.get("name", ""),
                              a.get("product", ""), a.get("version", ""), a.get("extrainfo", ""),
                              a.get("tunnel", ""), scripts, ostype=a.get("ostype", "")))
        hosts.append(Host(addr, hn.get("name") if hn is not None else "", os_name, ports, hostscripts))
    return hosts


def host_os_family(host):
    fam = os_family(host.os) or os_family(host.hostscripts.get("smb-os-discovery", "").split("\n")[0])
    if fam:
        return fam
    votes = [os_family(p.ostype or p.extrainfo) for p in host.ports]
    votes = [v for v in votes if v]
    return max(set(votes), key=votes.count) if votes else None


def build_softwares(host):
    """Work out which products+versions to hunt on each port."""
    smb = re.search(r"Samba (\d+(?:\.\d+)+[\w]*)", host.hostscripts.get("smb-os-discovery", ""))
    for port in host.ports:
        sws, keys = [], set()

        def add(sw):
            if sw and sw.key not in keys:
                keys.add(sw.key)
                sws.append(sw)

        sw = make_software(port.product, port.version)
        if sw and not sw.version and "samba" in port.product.lower() and smb:
            sw.version, sw.raw_version, sw.origin = smb.group(1), smb.group(1), "smb-os-discovery"
        add(sw)
        header = port.scripts.get("http-server-header", "")
        for name, ver in re.findall(r"([A-Za-z][\w\-]*)/(\d[\w.\-]*)", header):
            add(make_software(name, ver, "server header", known_only=bool(port.product)))
        gen = port.scripts.get("http-generator", "")
        m = re.match(r"\s*([A-Za-z][\w!.\- ]*?)\s+v?(\d+(?:\.\d+)*)", gen)
        if m:
            add(make_software(m.group(1).replace("!", ""), m.group(2), "http-generator"))
        port.softwares = sws
    return host


def port_notes(port):
    notes = []
    for sid, label in (("ftp-anon", "ftp-anon"), ("http-title", "title"), ("http-robots.txt", "robots"),
                       ("ssl-cert", "cert"), ("http-generator", "generator"), ("http-methods", "methods")):
        out = port.scripts.get(sid)
        if not out:
            continue
        line = next((l.strip() for l in out.strip().splitlines() if l.strip()), "")
        if sid == "http-methods" and "risky" not in out.lower():
            continue
        if sid == "http-methods":
            line = next((l.strip() for l in out.splitlines() if "risky" in l.lower()), line)
        notes.append(f"{label}: {line[:60]}")
    return notes


