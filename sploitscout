EXAMPLES = """
examples:
  sploitscout 10.10.10.5                    full scan: sudo nmap -A -T4 -p- 10.10.10.5, then hunt
  sploitscout 10.10.10.5 --fast             find open ports first, then -A only on those (much faster)
  sploitscout 10.10.10.5 -r                 also save an HTML report
  sploitscout 10.10.10.5 -b                 also open a Google search per service in Chromium
  sploitscout -x scan.xml                   use a scan you already ran (nmap -oX scan.xml ...)
  sploitscout -s "vsftpd 2.3.4"             just look up one product + version
  sploitscout 10.10.10.5 --no-web --all     offline only, show every result
"""


def parse_args():
    ap = argparse.ArgumentParser(
        prog="sploitscout", formatter_class=argparse.RawDescriptionHelpFormatter, epilog=EXAMPLES,
        description="Scan a target with nmap, then find, rank and explain public exploits for every service "
                    "version (searchsploit, Metasploit, GitHub PoCs). Recon only: never runs an exploit.")
    ap.add_argument("target", nargs="?", help="IP / hostname / CIDR to scan")
    ap.add_argument("-x", "--xml", metavar="FILE", help="skip scanning and use an existing nmap XML file")
    ap.add_argument("-s", "--search", metavar='"PRODUCT VER"', help='look up one service, e.g. -s "vsftpd 2.3.4"')
    ap.add_argument("--fast", action="store_true", help="find open ports first, then run -A only on them")
    ap.add_argument("--pn", action="store_true", help="skip host discovery (nmap -Pn), for hosts that block ping")
    ap.add_argument("--no-web", action="store_true", help="skip the GitHub PoC search (offline mode)")
    ap.add_argument("-b", "--browser", action="store_true",
                    help="open a Google search per service in Chromium (or your browser) at the end")
    ap.add_argument("--no-msf", action="store_true", help="skip Metasploit")
    ap.add_argument("--no-edb", action="store_true", help="skip searchsploit / Exploit-DB")
    ap.add_argument("--min-score", type=int, default=30, metavar="N", help="hide results below N (default 30)")
    ap.add_argument("--top", type=int, default=8, metavar="N", help="max results per service (default 8)")
    ap.add_argument("--all", action="store_true", help="show every result, ignore --min-score/--top")
    ap.add_argument("--howto", type=int, default=3, metavar="N", help="usage commands for top N per service (default 3)")
    ap.add_argument("--lhost", metavar="IP", help="your IP for Metasploit LHOST (auto-detected)")
    ap.add_argument("-r", "--report", nargs="?", const="", metavar="FILE",
                    help="save a report: .html (default), .md, .json or .svg")
    ap.add_argument("-o", "--outdir", metavar="DIR", help="where to save scan files (default ./sploitscout_<target>_<time>)")
    ap.add_argument("-V", "--version", action="version", version=f"sploitscout {VERSION}")
    args = ap.parse_args()
    if not (args.target or args.xml or args.search):
        console.print(banner())
        ap.print_help()
        sys.exit(0)
    return args


def tool_line(edb, msf, gh, need_nmap):
    t = Text("  ")
    if need_nmap:
        nm = shutil.which("nmap")
        if nm:
            v = subprocess.run(["nmap", "--version"], capture_output=True, text=True).stdout
            m = re.search(r"Nmap version (\S+)", v)
            t.append("✔ ", "bold green").append("nmap ", "bold").append(f"{m.group(1) if m else ''}   ", "grey62")
        else:
            t.append("✘ nmap ", "bold red").append("(sudo pacman -S nmap)   ", "grey62")
    for src, label, count in ((edb, "searchsploit", lambda: f"{len(edb.rows):,} exploits"),
                              (msf, "metasploit", lambda: f"{len(msf.mods):,} modules"),
                              (gh, "github", lambda: "PoC search" + (" (gh login)" if gh.mode == "gh"
                                                                     else " (no gh login: slower)"))):
        if src is None:
            t.append("○ ", "grey50").append(f"{label} ", "grey50").append("off   ", "grey50")
        elif src.ok:
            t.append("✔ ", "bold green").append(f"{label} ", "bold").append(f"{count()}   ", "grey62")
        else:
            t.append("✘ ", "bold red").append(f"{label} ", "bold").append(f"{src.error}   ", "grey62")
    return t


def main():
    args = parse_args()
    if args.all:
        args.min_score, args.top = 0, 10 ** 6
    started = time.time()
    record = []  # everything that goes into the HTML report

    def out(r="", soft=False):
        console.print(r, soft_wrap=soft)
        record.append((r, soft))

    out(banner())

    edb = None if args.no_edb else ExploitDB()
    msf = None if args.no_msf else Metasploit()
    gh = None if args.no_web else GitHub()
    with console.status("[bold magenta]Loading exploit databases…", spinner="dots12"):
        if edb:
            edb.load()
        if msf:
            msf.load()
        if gh:
            gh.load()
    console.print(tool_line(edb, msf, gh, need_nmap=not (args.xml or args.search)))
    if not any(s and s.ok for s in (edb, msf, gh)):
        console.print("[red]✘ No exploit source available.[/]")
        sys.exit(1)

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    nmap_cmd = ""
    outdir = None

    # ── get hosts ──────────────────────────────────────────────────────────
    if args.search:
        m = re.match(r"^(.*?)\s+(v?\d[\w.\-]*)\s*$", args.search.strip())
        product, version = (m.group(1), m.group(2)) if m else (args.search.strip(), "")
        target = args.target or "<target>"
        port = Port(0, "tcp", "manual", product, version, "", "", {})
        host = Host(target, "", "", [port], {})
        sw = make_software(product, version) or Software(product, *norm_version(version),
                                                         [product.lower()], [], "manual")
        port.softwares = [sw]
        hosts = [host]
        meta_target = args.search
    elif args.xml:
        try:
            with open(args.xml, encoding="utf-8", errors="replace") as fh:
                hosts = parse_nmap_xml(fh.read())
        except (OSError, ET.ParseError) as e:
            console.print(f"[red]✘ Can't read {args.xml}: {e}[/]")
            sys.exit(1)
        meta_target = args.xml
        step(1, f"Loaded nmap results from {os.path.basename(args.xml)}")
    else:
        if not shutil.which("nmap"):
            console.print("[red]✘ nmap not found: sudo pacman -S nmap[/]")
            sys.exit(1)
        meta_target = args.target
        targets = [args.target]
        pn = ["-Pn"] if args.pn else []
        safe = re.sub(r"[^\w.\-]", "_", args.target)
        outdir = args.outdir or f"sploitscout_{safe}_{stamp}"
        os.makedirs(outdir, exist_ok=True)
        tmp = tempfile.mkdtemp(prefix="sploitscout_")
        try:
            step(1, "Nmap scan")
            if args.fast:
                nmap_cmd = f"sudo nmap -p- --min-rate 3000 -T4 {args.target}  →  sudo nmap -A -T4 -p <open> {args.target}"
                console.print(f"  [bold cyan][*][/] Scanning [bold white]{args.target}[/] with nmap "
                              f"[dim](fast mode: ports first, then -A on open ones)[/]")
                console.print(f"  [dim]$ sudo nmap -p- --min-rate 3000 -T4 {' '.join(pn)} {args.target}[/]")
                xml1, _, _ = run_nmap(["-p-", "--min-rate", "3000", "-T4", *pn], targets, tmp, "ports", True)
                open_ports = sorted({p.port for h in parse_nmap_xml(xml1) for p in h.ports})
                if not open_ports:
                    console.print("  [yellow]No open ports found.[/]" +
                                  ("" if args.pn else " If the host blocks ping, retry with [bold]--pn[/]."))
                    sys.exit(0)
                plist = ",".join(map(str, open_ports))
                console.print(f"  [bold cyan][*][/] Running [bold]-A[/] on {len(open_ports)} open port{'s' if len(open_ports) != 1 else ''}")
                console.print(f"  [dim]$ sudo nmap -A -T4 -p {plist} {' '.join(pn)} {args.target}[/]")
                xml_text, txt, tail = run_nmap(["-A", "-T4", "-p", plist, *pn], targets, tmp, "full", False,
                                               show_ports=False)
            else:
                nmap_cmd = f"sudo nmap -A -T4 -p- {' '.join(pn) + ' ' if pn else ''}{args.target}"
                console.print(f"  [bold cyan][*][/] Scanning [bold white]{args.target}[/] with nmap")
                console.print(f"  [dim]$ {nmap_cmd}   (scans all 65,535 ports; this can take a while. "
                              f"--fast is quicker)[/]")
                xml_text, txt, tail = run_nmap(["-A", "-T4", "-p-", *pn], targets, tmp, "full", True)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        with open(os.path.join(outdir, "nmap.xml"), "w", encoding="utf-8") as fh:
            fh.write(xml_text)
        with open(os.path.join(outdir, "nmap.txt"), "w", encoding="utf-8") as fh:
            fh.write(txt)
        hosts = parse_nmap_xml(xml_text)
        console.print(f"  [bold green][+][/] Scan done in {time.time() - started:.0f}s  "
                      f"[dim]→ saved {outdir}/nmap.txt + nmap.xml[/]", soft_wrap=True)
        if not hosts:
            hint = "" if args.pn else " If it's up but blocks ping, retry with [bold]--pn[/]."
            console.print(f"  [yellow]Host looks down.{hint}[/]")
            sys.exit(0)

    if not args.search:
        for h in hosts:
            build_softwares(h)
    lhost = args.lhost or local_ip_for(hosts[0].addr if hosts and hosts[0].addr != "<target>" else "8.8.8.8")

    # ── show services ──────────────────────────────────────────────────────
    if not args.search:
        for h in hosts:
            head = Text.assemble(("\n  🖥  ", ""), (h.addr, "bold white"),
                                 (f"  ({h.hostname})" if h.hostname else "", "cyan"),
                                 (f"   OS: {h.os}" if h.os else "", "grey62"),
                                 (f"   {len(h.ports)} open port{'s' if len(h.ports) != 1 else ''}", "bold green"))
            out(head)
            if h.ports:
                out(services_table(h))
            else:
                out(Text("  No open ports.", style="yellow"))

    # ── hunt ───────────────────────────────────────────────────────────────
    step(2 if not args.search else 1, "Exploit hunt")
    out(legend())
    cache, results, all_rows = {}, [], []
    total_found = 0
    for h in hosts:
        port_rows = []
        skipped = []
        hos = host_os_family(h)
        for p in h.ports:
            if not p.softwares:
                skipped.append(f"{p.port}/{p.proto} {p.service or '?'}")
                continue
            for sw in p.softwares:
                with console.status(f"[bold magenta]Hunting exploits for[/] [bold white]{sw.label}[/] "
                                    f"[dim](searchsploit · metasploit{' · github' if gh and gh.ok else ''})[/]",
                                    spinner="dots12"):
                    fs = hunt(sw, edb, msf, gh, cache, hos)
                total_found += len(fs)
                port_rows.append((p, sw, fs))
                for f in fs:
                    all_rows.append((h, p, sw, f))
                for r, soft in findings_block(h, p, sw, fs, args, lhost):
                    out(r, soft)
        if skipped:
            out(Text(f"\n  ⓘ No product/version from nmap, nothing to search: {', '.join(skipped)}",
                     style="grey50 italic"))
        results.append((h, port_rows))
    if gh and not gh.ok:
        out(Text(f"\n  ⚠ GitHub search stopped ({gh.error}); some PoC repos may be missing. "
                 f"Log in with `gh auth login` for a higher limit.", style="yellow"))
    # Google searches for you to open (clickable in most terminals, or -b opens them in Chromium)
    gurls, done = [], set()
    for _, port_rows in results:
        for _, sw, _ in port_rows:
            for q in google_queries(sw):
                if q not in done:
                    done.add(q)
                    gurls.append((q, google_url(q)))
    if gurls:
        out(Text("\n  🔎 Dig further on Google (ctrl+click, or run with -b to open them in Chromium):",
                 style="bold magenta"))
        for q, url in gurls:
            out(Text.assemble(("     • ", "magenta"), (q, f"bold link {url}"), (f"  {url}", "grey50")), True)
        if args.browser:
            console.print(f"  [green]🌐 {open_in_browser([u for _, u in gurls])}[/]")

    # ── summary ────────────────────────────────────────────────────────────
    step(3 if not args.search else 2, "Summary")
    top = sorted([r for r in all_rows if r[3].score >= args.min_score], key=lambda r: -r[3].score)
    seen, per_service, uniq = set(), {}, []
    for r in top:  # best 2 per service, so one service can't crowd out the rest
        k, svc = (r[0].addr, r[1].port, r[3].ref), (r[0].addr, r[1].port, r[2].key)
        if k in seen or per_service.get(svc, 0) >= 2:
            continue
        seen.add(k)
        per_service[svc] = per_service.get(svc, 0) + 1
        uniq.append(r)
    if uniq:
        out(summary_table(uniq[:10], args))
    else:
        out(Text("  No exploit scored above the threshold. Try --all, or dig into the services manually.",
                 style="yellow"))
    relevant = [r for r in all_rows if r[3].score >= args.min_score]
    crit = sum(1 for r in relevant if r[3].score >= 80)
    high = sum(1 for r in relevant if 60 <= r[3].score < 80)
    nserv = sum(len(pr) for _, pr in results)
    stats = Text.assemble(("  ", ""), (f"{nserv}", "bold white"),
                          (f" service{'s' if nserv != 1 else ''} checked · ", "grey62"),
                          (f"{len(relevant)}", "bold white"), (f" exploits scored {args.min_score}+ · ", "grey62"),
                          (f"{crit} critical", "bold red"), (" · ", "grey62"), (f"{high} high", "bold dark_orange"),
                          (f" · {total_found - len(relevant)} weak matches hidden", "grey50"),
                          (f" · {time.time() - started:.0f}s", "grey62"))
    out(stats)

    # ── reports ────────────────────────────────────────────────────────────
    meta = {"target": meta_target, "date": datetime.now().isoformat(timespec="seconds"), "cmd": nmap_cmd,
            "lhost": lhost, "tool": f"sploitscout {VERSION}"}
    if outdir:
        write_json(os.path.join(outdir, "results.json"), meta, results)
    if args.report is not None:
        path = args.report or os.path.join(outdir or ".", f"sploitscout_report_{stamp}.html")
        ext = os.path.splitext(path)[1].lower()
        if ext == ".md":
            write_markdown(path, meta, results, args)
        elif ext == ".json":
            write_json(path, meta, results)
        elif ext == ".svg":
            write_html(path, record, f"sploitscout · {os.path.basename(meta_target)}", svg=True)
        else:
            if ext not in (".html", ".htm"):
                path += ".html"
            write_html(path, record, f"sploitscout · {meta_target}")
        console.print(f"  [bold green]📄 Report saved:[/] {path}", soft_wrap=True)
    if outdir:
        console.print(f"  [dim]📁 All files in {outdir}/[/]", soft_wrap=True)
    console.print()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        console.print("\n[yellow]✋ Interrupted.[/]")
        sys.exit(130)
