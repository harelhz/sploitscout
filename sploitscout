    r"\((.*?)\)|\b(httpd|smtpd|ftpd|imapd|pop3d|sshd|smbd|named|daemon|server|service|http|web|"
    r"key-value store|db|rest api|framework|ssl|tls|proxy|engine)\b", re.I)


# products where nmap's "version" is a protocol version, not the software version
PROTOCOL_VERSION = re.compile(r"distcc|java rmi|rmiregistry|vnc|apache jserv|x11", re.I)


def norm_version(raw, product=""):
    raw = (raw or "").strip()
    if re.search(r"\d\.[xX]\b", raw):  # e.g. Samba "3.X - 4.X": nmap is guessing
        return "", raw
    if raw and PROTOCOL_VERSION.search(product):
        return "", f"{raw} (protocol)"
    m = re.search(r"\d+(?:\.\d+)*[a-z]*\d*", raw)
    return (m.group(0) if m else ""), raw


@dataclass
class Software:
    product: str
    version: str
    raw_version: str
    keywords: list
    exclude: list
    origin: str = "nmap"

    @property
    def label(self):
        return f"{self.product} {self.raw_version}".strip()

    @property
    def key(self):
        return (tuple(self.keywords), self.version)


def make_software(product, version, origin="nmap", known_only=False):
    p = (product or "").strip()
    pl = p.lower()
    if not p:
        return None
    for rx, kws, excl in ALIASES:
        if re.search(rx, pl):
            if kws is None:
                return None
            break
    else:
        if known_only:
            return None
        kw = " ".join(GENERIC_STRIP.sub(" ", pl).split()[:3])
        if len(kw) < 2:
            return None
        kws, excl = [kw], []
    ver, raw = norm_version(version, p)
    return Software(p, ver, raw, list(kws), list(excl), origin)


def os_family(text):
    t = (text or "").lower()
    if "windows" in t:
        return "windows"
    if any(w in t for w in ("linux", "unix", "bsd", "solaris", "aix", "ubuntu", "debian", "centos")):
        return "unix"
    return None


