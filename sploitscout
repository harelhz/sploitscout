def inherit_tiers(fs):
    """An entry with no version in its title borrows the match of another entry with the same CVE/EDB id."""
    best = {}
    for f in fs:
        if f.tier == "product":
            continue
        for r in f.refs:
            if r not in best or TIER_W[f.tier] > TIER_W[best[r]]:
                best[r] = f.tier
    for f in fs:
        if f.tier == "product":
            cands = [(best[r], r) for r in f.refs if r in best]
            if cands:
                tier, r = max(cands, key=lambda c: TIER_W[c[0]])
                f.tier, f.reason = tier, f"{tier} via {r}"


def _finish(fs, host_os):
    for f in fs:
        fam = f.extra.get("os_family")
        if host_os and fam and fam != host_os and not f.extra.get("os_mismatch"):  # Windows-only on Linux…
            f.extra["os_mismatch"] = True
            f.reason += f" !{'windows' if fam == 'windows' else 'unix'}-only"
        f.compute()


def hunt(sw, edb, msf, gh, cache, host_os=None):
    ck = (sw.key, host_os)
    if ck in cache:
        return cache[ck]
    T = V(sw.version) if sw.version else None
    fs = []
    if edb and edb.ok:
        fs += edb.search(sw, T)
    if msf and msf.ok:
        fs += msf.search(sw, T)
    inherit_tiers(fs)
    _finish(fs, host_os)
    if gh and gh.ok:
        # look for GitHub PoCs of the strongest CVEs we already matched to this version
        cve_info = {}
        for f in sorted(fs, key=lambda f: -f.score):
            if f.score < 40 or f.tier in ("product", "unknown"):
                continue
            for c in f.cves:
                cve_info.setdefault(c, (f.tier, f.impact.removeprefix("Local "), f.impact_pts))
        ghf = gh.search(sw, T, cve_info)
        _finish(ghf, host_os)
        fs += ghf
    fs.sort(key=lambda f: (-f.score, SRC_ORDER[f.source], f.name))
    cache[ck] = fs
    return fs


