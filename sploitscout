def classify_impact(text, kind=""):
    if kind == "dos":
        return "DoS", 8
    t = text.lower()
    for label, pts, rx in IMPACTS:
        if re.search(rx, t):
            if kind == "local" and label not in ("DoS",):
                return f"Local {label}" if label != "PrivEsc" else "Local PrivEsc", max(pts - 8, 10)
            return label, pts
    return "Other", 20


@dataclass
class Finding:
    source: str
    name: str
    ref: str
    tier: str
    reason: str
    impact: str
    impact_pts: int
    rel_label: str
    rel_pts: int
    cves: list = field(default_factory=list)
    refs: set = field(default_factory=set)
    extra: dict = field(default_factory=dict)
    score: int = 0

    def compute(self):
        s = TIER_W[self.tier] * min(100, self.impact_pts + self.rel_pts)
        if self.extra.get("os_mismatch"):
            s *= 0.6
        self.score = max(0, min(100, round(s)))
        return self.score

    def as_dict(self):
        return {"score": self.score, "source": self.source, "name": self.name, "ref": self.ref,
                "match": self.tier, "why": self.reason, "impact": self.impact,
                "reliability": self.rel_label, "cves": self.cves, **self.extra}


