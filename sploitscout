# header separator made of plain dashes, no outer borders
HACK_BOX = box.Box("    \n    \n -- \n    \n    \n    \n    \n    \n", ascii=True)
TAG_STYLE = {"*": MID, "+": C_GOOD, "!": C_BAD, ">": C_GOOD, "-": LO, "?": MID, "=": MID, "i": LO}


def banner():
    rows = ["".join(LETTERS[c][i] for c in "SPLOIT") for i in range(6)]
    rows += [" " + "".join(LETTERS[c][i] for c in "SCOUT") for i in range(6)]
    t = Text()
    for row in rows:  # black & white: solid blocks bright white, shadow edges grey
        t.append("  ")
        for ch in row:
            t.append(ch, style=HI if ch == "█" else LO)
        t.append("\n")
    t.append("\n  nmap > exploits > ranked", style=FG)
    t.append(f"   v{VERSION} // recon only. never fires.\n", style=MID)
    t.append("  " + "─" * 66 + "\n", style=LO)
    t.append(f"  [ sess 0x{random.getrandbits(16):04x} ]  [ {datetime.now():%Y-%m-%d %H:%M:%S} ]"
             f"  [ authorized targets only ]\n", style=LO)
    return t


def say(tag, *parts):
    """One status line: '[+] text'. parts are strings or (string, style) pairs."""
    t = Text("  ")
    t.append(f"[{tag}] ", style=TAG_STYLE.get(tag, MID))
    for p in parts:
        if isinstance(p, tuple):
            t.append(*p)
        else:
            t.append(p, style=FG)
    return t


def step(n, title):
    return Group(Text(""), Rule(Text.assemble((f"[ 0x{n:02x} ] ", MID), (title.upper(), HI), " "),
                                align="left", style=LO, characters="─"))


def sev(score):
    if score >= 80:
        return "CRIT", "bold white on red3"
    if score >= 60:
        return "HIGH", "bold black on dark_orange"
    if score >= 40:
        return "MED", "bold black on yellow3"
    return "LOW", "grey70 on grey23"


def sev_badge(score):
    label, style = sev(score)
    return Text(f"{score:>3} {label:<4}", style=style)


def legend():
    t = say("i", ("score = version match x (impact + reliability)   ", LO))
    for s, rng in ((80, "80+"), (60, "60+"), (40, "40+"), (0, "<40")):
        label, style = sev(s)
        t.append(f" {label} ", style=style)
        t.append(f" {rng}  ", style=LO)
    return t


def impact_style(f):
    return IMPACT_STYLE.get(f.impact.removeprefix("Local "), FG)


class Responsive:
    """Pick the wide or the compact layout from the width it's actually drawn at."""

    def __init__(self, wide, narrow, min_width=112):
        self.wide, self.narrow, self.min_width = wide, narrow, min_width

    def __rich_console__(self, console, options):
        yield self.wide if options.max_width >= self.min_width else self.narrow


def services_table(host):
    t = Table(box=box.ASCII_DOUBLE_HEAD, border_style=LO, header_style=HI, expand=False)
    t.add_column("PORT", style=C_PORT, no_wrap=True)
    t.add_column("SERVICE", style=FG, no_wrap=True)
    t.add_column("PRODUCT / VERSION")
    t.add_column("NMAP NOTES", overflow="fold")
    for p in host.ports:
        svc = (f"{p.tunnel}/" if p.tunnel else "") + (p.service or "?")
        pv = Text(p.product or "unknown", style=HI if p.product else LO)
        if p.version:
            pv.append(f" {p.version}", style=C_VER)
        if p.extrainfo:
            pv.append(f" ({p.extrainfo})", style=LO)
        for sw in p.softwares:
            if sw.origin != "nmap":
                pv.append(f"\n+ {sw.product}", style=HI)
                pv.append(f" {sw.raw_version}", style=C_VER)
                pv.append(f" ({sw.origin})", style=LO)
        notes = Text()
        for i, n in enumerate(port_notes(p)):  # juicy nmap notes (anon login, risky methods) in yellow
            juicy = re.search(r"anonymous.*allowed|risky|vulnerable|writable|default (?:cred|pass)", n, re.I)
            notes.append(("\n" if i else "") + n, style=C_WARN if juicy else LO)
        t.add_row(f"{p.port}/{p.proto}", svc, pv, notes)
    return t


def short_ref(f):
    if f.source == "searchsploit":
        bits = [f.ref, *f.cves[:2], f.rel_label]
    elif f.source == "metasploit":
        bits = [f.ref, f.rel_label] + (["check:yes"] if f.extra.get("check") else []) + f.cves[:2]
    else:
        bits = [f"github.com/{f.extra.get('repo', '')}", f.rel_label,
                f"upd {f.extra['updated']}" if f.extra.get("updated") else "", *f.cves[:2]]
    return " // ".join(b for b in bits if b)


def howto(f, ip, port, lhost, native=None):
    """Copy-paste commands to look at / load an exploit. Never runs anything itself.
    native: {CVE: metasploit module} found for the same service, used for old EDB msf modules."""
    cmds = []
    native = native or {}
    if not port:  # manual lookup: no real port, use the module's default if it has one
        port = f.extra.get("default_rport") or "<port>"
    if f.source == "searchsploit":
        eid = f.extra["edb_id"]
        ext = os.path.splitext(f.extra["path"])[1].lower()
        fn = f"{eid}{ext}"
        cmds.append((f"searchsploit -x {eid}", "read it first"))
        cmds.append((f"searchsploit -m {eid}", f"copy it here as {fn}"))
        runner = {".py": f"python3 {fn} -h", ".sh": f"bash {fn}", ".pl": f"perl {fn}", ".php": f"php {fn}",
                  ".js": f"node {fn}", ".go": f"go run {fn}", ".ps1": f"pwsh {fn}",
                  ".c": f"gcc {fn} -o x{eid} && ./x{eid}", ".cpp": f"g++ {fn} -o x{eid} && ./x{eid}",
                  ".java": f"javac {fn}", ".rb": f"ruby {fn}"}.get(ext)
        if ext == ".rb" and "metasploit" in f.name.lower():
            mod = next((native[c] for c in f.cves if c in native), None)
            if mod:  # old EDB copies of msf modules often don't load in msf6: use the built-in one
                cmds = [(f'msfconsole -q -x "use {mod}; set RHOSTS {ip}; set RPORT {port}; show options"',
                         "same exploit is built into metasploit: use that one")]
            else:
                cmds.append((f"mkdir -p ~/.msf4/modules/exploits/edb && cp {fn} ~/.msf4/modules/exploits/edb/",
                             "it's an msf module: install it"))
                cmds.append((f'msfconsole -q -x "use exploit/edb/{eid}; set RHOSTS {ip}; set RPORT {port}; '
                             f'show options"', "load it with your target"))
        elif runner:
            cmds.append((runner, f"check its usage, then point it at {ip}:{port}"))
        else:
            cmds.append((f"less {fn}", "manual steps: follow the write-up"))
    elif f.source == "metasploit":
        mod = f.extra["module"]
        opts = f"use {mod}; set RHOSTS {ip}; set RPORT {port}"
        if f.extra.get("type") == "exploit":
            opts += f"; set LHOST {lhost}"
        opts += "; check" if f.extra.get("check") else "; show options"
        cmds.append((f'msfconsole -q -x "{opts}"',
                     "loads it with your target set" + (", runs 'check'" if f.extra.get("check") else "")))
        cmds.append(("run", "type this inside msfconsole when you're ready"))
    else:
        url = f.ref
        m = re.match(r"https?://github\.com/([^/]+)/([^/#?]+)", url)
        if m:
            repo = m.group(2).removesuffix(".git")
            cmds.append((f"git clone https://github.com/{m.group(1)}/{repo}", "grab the PoC"))
            cmds.append((f"less {repo}/README.md", f"read the usage, target is {ip}:{port}"))
            cmds.append((f"grep -rnE 'curl|wget|base64|eval|exec' {repo} | head",
                         "! read the code before running it: fake PoCs with malware exist"))
        else:
            cmds.append((f"xdg-open '{url}'", "read the write-up in your browser"))
    return cmds


def _findings_table(shown, wide):
    t = Table(box=HACK_BOX, header_style=HI, border_style=LO, expand=True, padding=(0, 1), show_edge=False)
    t.add_column("#", style=LO, width=2, justify="right")
    t.add_column("SCORE", width=8, no_wrap=True)
    t.add_column("EXPLOIT", ratio=6, overflow="fold")
    t.add_column("SOURCE", width=12, no_wrap=True)
    if wide:
        t.add_column("MATCH", ratio=2, overflow="fold")
        t.add_column("TYPE", no_wrap=True)
    for i, f in enumerate(shown, 1):
        name = Text(f.name, style=HI)
        name.append("\n" + short_ref(f), style=LO)
        if not wide:
            name.append("\nmatch: ", style=MID)
            name.append(f.reason, style=TIER_STYLE[f.tier])
            name.append(" // ", style=LO)
            name.append(f.impact, style=impact_style(f))
        row = [f"{i:02d}", sev_badge(f.score), name, Text(f.source, style=SRC_STYLE[f.source])]
        if wide:
            row += [Text(f.reason, style=TIER_STYLE[f.tier]), Text(f.impact, style=impact_style(f))]
        t.add_row(*row)
    return t


def findings_block(host, port, sw, fs, args, lhost):
    """Everything printed for one service. Returns [(renderable, soft_wrap)].
    Commands are printed with soft_wrap so a long command copies as one clean line."""
    ip = host.addr
    shown = fs if args.all else [f for f in fs if f.score >= args.min_score][: args.top]
    hidden = len(fs) - len(shown)
    title = Text(">> ", style=LO)
    if port.port:
        title.append(f"{port.port}/{port.proto}", style=C_PORT)
        title.append(f"  {port.service or '?'}", style=MID)
    else:
        title.append("lookup", style=C_PORT)
    title.append("  ::  ", style=LO)
    title.append(sw.product, style=HI)
    title.append(f" {sw.raw_version}" if sw.raw_version else " (version unknown)",
                 style=C_VER if sw.version else LO)
    if sw.origin not in ("nmap", "manual"):
        title.append(f"  [{sw.origin}]", style=LO)
    title.append(" ")
    parts = [(Text(""), False), (Rule(title, align="left", style=LO, characters="─"), False)]
    if not shown:
        parts.append((say("-", ("no public exploits matched this version", FG),
                          (f" above score {args.min_score} ({len(fs)} weaker, --all)" if fs else "", LO)), False))
        parts.append((Text("      not proof it's safe: check default creds, misconfigs and the web app itself.",
                           style=LO), False))
        return parts
    parts.append((Responsive(_findings_table(shown, True), _findings_table(shown, False)), False))
    if hidden:
        parts.append((say("-", (f"{hidden} weaker hits hidden (score < {args.min_score}"
                                f"{', past --top ' + str(args.top) if len(fs) > args.top else ''})"
                                f" // --all to show", LO)), False))
    if args.howto > 0:
        native = {c: f.extra["module"] for f in fs if f.source == "metasploit" and f.extra.get("type") == "exploit"
                  for c in f.cves}
        parts.append((Text(""), False))
        parts.append((say(">", ("usage", HI)), False))
        for i, f in enumerate(shown[: args.howto], 1):
            parts.append((Text.assemble(("      ", ""), (f"#{i:02d} ", MID), (f.name, HI),
                                        ("  (", LO), (f.source, SRC_STYLE[f.source]), (")", LO)), False))
            for cmd, note in howto(f, ip, port.port, lhost, native):
                parts.append((Text.assemble(("      $ ", LO), (cmd, C_CMD), (f"   # {note}", LO)), True))
    return parts


def _summary(rows, wide):
    t = Table(box=box.ASCII_DOUBLE_HEAD, border_style=LO, header_style=HI, expand=True)
    t.add_column("SCORE", width=8, no_wrap=True)
    t.add_column("TARGET", no_wrap=wide, ratio=None if wide else 2, overflow="fold")
    if wide:
        t.add_column("SERVICE", style=FG, ratio=2, overflow="fold")
    t.add_column("EXPLOIT", ratio=5, overflow="fold")
    if wide:
        t.add_column("SOURCE", width=12, no_wrap=True)
    for host, port, sw, f in rows:
        where = Text(f"{host.addr}:{port.port}" if port.port else "lookup", style=C_PORT)
        what = Text(f.name, style=HI) + Text(f"\n{f.ref}", style=LO)
        svc = Text(sw.product, style=FG) + Text(f" {sw.raw_version}" if sw.raw_version else "", style=C_VER)
        src = Text(f.source, style=SRC_STYLE[f.source])
        if wide:
            t.add_row(sev_badge(f.score), where, svc, what, src)
        else:
            where.append("\n")
            where.append_text(svc)
            what.append("\n")
            what.append_text(src)
            t.add_row(sev_badge(f.score), where, what)
    return t


def summary_table(rows, args):
    return Responsive(_summary(rows, True), _summary(rows, False), min_width=120)


def local_ip_for(target):
    try:
        dest = socket.gethostbyname(target.split("/")[0])
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((dest, 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return "<your-ip>"


