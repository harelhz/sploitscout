)

# how much each kind of version match is worth (multiplies impact + reliability)
TIER_W = {"exact": 1.00, "range": 0.95, "family": 0.85, "near": 0.60,
          "major": 0.50, "unknown": 0.45, "product": 0.30}
DOWNGRADE = {"exact": "near", "range": "near", "family": "major", "near": "product", "major": "product",
             "unknown": "product"}
